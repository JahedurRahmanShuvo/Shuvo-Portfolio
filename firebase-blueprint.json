{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "photoUrl": { "type": "string" },
        "email": { "type": "string" },
        "socials": { "type": "object" },
        "stats": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "title", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio project entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "github": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical skill entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "Hire": {
      "title": "Hire",
      "description": "Contact form submission",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "profile/main": {
      "schema": "Profile",
      "description": "The main user profile document"
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects"
    },
    "skills/{skillId}": {
      "schema": "Skill",
      "description": "Collection of skills"
    },
    "hires/{hireId}": {
      "schema": "Hire",
      "description": "Collection of contact inquiries"
    }
  }
}
